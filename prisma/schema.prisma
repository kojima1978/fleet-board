generator client {
  provider = "prisma-client"
  output   = "../prisma/generated"
}

datasource db {
  provider = "postgresql"
}

enum VehicleStatus {
  AVAILABLE
  RESERVED
  IN_USE
  MAINTENANCE
}

enum TripStatus {
  RESERVED
  IN_USE
  COMPLETED
  CANCELLED
}

model Employee {
  id               String         @id @default(cuid())
  employeeNumberId String
  employeeNumber   EmployeeNumber @relation(fields: [employeeNumberId], references: [id])
  departmentId     String
  department       Department     @relation(fields: [departmentId], references: [id])
  name             String
  active           Boolean        @default(true)
  version          Int            @default(1)
  nfcAssignments   NfcAssignment[]
  auditLogs        AuditLog[]
  trips            Trip[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([employeeNumberId])
  @@index([departmentId])
}

model EmployeeNumber {
  id        String     @id @default(cuid())
  code      String     @unique
  employees Employee[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Department {
  id        String     @id @default(cuid())
  name      String     @unique
  active    Boolean    @default(true)
  employees Employee[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model NfcTag {
  id          String          @id @default(cuid())
  uid         String          @unique
  assignments NfcAssignment[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model NfcAssignment {
  id         String    @id @default(cuid())
  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id])
  vehicleId  String?
  vehicle    Vehicle?  @relation(fields: [vehicleId], references: [id])
  nfcTagId   String
  nfcTag     NfcTag    @relation(fields: [nfcTagId], references: [id])
  validFrom  DateTime  @default(now())
  validTo    DateTime?
  createdAt  DateTime  @default(now())

  @@index([employeeId, validTo])
  @@index([vehicleId, validTo])
  @@index([nfcTagId, validTo])
}

model Vehicle {
  id            String        @id @default(cuid())
  vehicleNumberId String
  vehicleNumber VehicleNumber @relation(fields: [vehicleNumberId], references: [id])
  name          String
  plateNumber   String        @unique
  color         String        @default("#2563eb")
  hasEtc        Boolean       @default(false)
  hasNavigation Boolean       @default(false)
  active        Boolean       @default(true)
  status        VehicleStatus @default(AVAILABLE)
  parkingSpotId String?       @unique
  parkingSpot   ParkingSpot?  @relation(fields: [parkingSpotId], references: [id])
  nfcAssignments NfcAssignment[]
  trips         Trip[]
  version       Int           @default(1)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([vehicleNumberId])
}

model VehicleNumber {
  id        String    @id @default(cuid())
  code      String    @unique
  vehicles  Vehicle[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model ParkingSpot {
  id          String   @id @default(cuid())
  code        String   @unique
  x           Float
  y           Float
  width       Float
  height      Float
  orientation String
  enabled     Boolean  @default(true)
  vehicle     Vehicle?
  version     Int      @default(1)
}

model Trip {
  id            String     @id @default(cuid())
  employeeId    String
  employee      Employee   @relation(fields: [employeeId], references: [id])
  vehicleId     String
  vehicle       Vehicle    @relation(fields: [vehicleId], references: [id])
  plannedStart  DateTime
  plannedEnd    DateTime
  actualStart   DateTime?
  actualEnd     DateTime?
  returnSpotCode String?
  purpose       String?
  status        TripStatus @default(RESERVED)
  version       Int        @default(1)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([plannedStart, plannedEnd])
  @@index([vehicleId, status])
}

model AuditLog {
  id          String   @id @default(cuid())
  operationId String?  @unique
  actorEmployeeId String?
  actorEmployee Employee? @relation(fields: [actorEmployeeId], references: [id], onDelete: SetNull)
  actorName   String
  action      String
  targetType  String
  targetId    String
  description String
  createdAt   DateTime @default(now())

  @@index([actorEmployeeId])
  @@index([createdAt])
}
