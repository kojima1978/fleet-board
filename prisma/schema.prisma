generator client {
  provider = "prisma-client"
  output   = "../prisma/generated"
}

datasource db {
  provider = "postgresql"
}

model FuelReturnNotice {
  level       Int      @id
  enabled     Boolean  @default(true)
  animated    Boolean  @default(true)
  message     String
  audioBase64 String?
  audioMime   String?
  audioName   String?
  version     Int      @default(1)
  updatedAt   DateTime @updatedAt
}

enum VehicleStatus {
  AVAILABLE
  RESERVED
  IN_USE
  MAINTENANCE
}

// 区画の役割。DEDICATEDはdedicatedVehicleIdの車両だけが駐車できる。
enum ParkingSpotRole {
  REGULAR
  TEMPORARY
  CUSTOMER
  DEDICATED
  HOLDING
}

// 整備の種類。ON_SITEは故障で駐車場内に置いたまま、OFF_SITEは車検・修理で外出し、ほかの車を停められるよう区画を空ける。
enum MaintenanceKind {
  ON_SITE
  OFF_SITE
}

enum MaintenanceStatus {
  SCHEDULED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum TripStatus {
  RESERVED
  IN_USE
  COMPLETED
  CANCELLED
}

model Employee {
  id               String         @id @default(cuid())
  employeeNumberId String
  employeeNumber   EmployeeNumber @relation(fields: [employeeNumberId], references: [id])
  departmentId     String
  department       Department     @relation(fields: [departmentId], references: [id])
    name             String
    email            String?        @unique
  // 社員番号とは独立したQRコード用の不変トークン。番号を再利用してもQRの割当先は変わらない。
  qrToken          String         @unique
  active           Boolean        @default(true)
  version          Int            @default(1)
  nfcAssignments   NfcAssignment[]
  auditLogs        AuditLog[]
  trips            Trip[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([employeeNumberId])
  @@index([departmentId])
}

model EmployeeNumber {
  id        String     @id @default(cuid())
  code      String     @unique
  employees Employee[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Department {
  id        String     @id @default(cuid())
  name      String     @unique
  active    Boolean    @default(true)
  // 部署の選択肢と絞り込みの並び順。小さいほど上に出る。
  sortOrder Int        @default(0)
  version   Int        @default(1)
  employees Employee[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model NfcTag {
  id          String          @id @default(cuid())
  uid         String          @unique
  assignments NfcAssignment[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model NfcAssignment {
  id         String    @id @default(cuid())
  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  vehicleId  String?
  vehicle    Vehicle?  @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  nfcTagId   String
  nfcTag     NfcTag    @relation(fields: [nfcTagId], references: [id])
  validFrom  DateTime  @default(now())
  validTo    DateTime?
  // 設定画面でUIDを消して外した割り当て。利用停止で外したものと区別し、再開しても戻さない。
  cleared    Boolean   @default(false)
  createdAt  DateTime  @default(now())

  @@index([employeeId, validTo])
  @@index([vehicleId, validTo])
  @@index([nfcTagId, validTo])
}

model Vehicle {
  id            String        @id @default(cuid())
  vehicleNumberId String
  vehicleNumber VehicleNumber @relation(fields: [vehicleNumberId], references: [id])
  name          String
  // 車両番号とは独立したQRコード用の不変トークン。
  qrToken       String        @unique
  plateNumber   String        @unique
  color         String        @default("#2563eb")
  hasEtc        Boolean       @default(false)
  hasNavigation Boolean       @default(false)
  hasWinterTires Boolean      @default(false)
  // 軽自動車。配置図では車アイコンを小さくし「軽」マークを付ける。
  isKei         Boolean       @default(false)
  // ガソリンカードの管理名（例：出光 末尾1234）。カード番号そのものは保存しない。
  fuelCard      String        @default("")
  fuelLevel     Int?
  active        Boolean       @default(true)
  status        VehicleStatus @default(AVAILABLE)
  parkingSpotId String?       @unique
  parkingSpot   ParkingSpot?  @relation(fields: [parkingSpotId], references: [id])
  dedicatedSpots ParkingSpot[] @relation("DedicatedVehicle")
  nfcAssignments NfcAssignment[]
  trips         Trip[]
  maintenances  VehicleMaintenance[]
  version       Int           @default(1)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([vehicleNumberId])
}

model VehicleNumber {
  id        String    @id @default(cuid())
  code      String    @unique
  vehicles  Vehicle[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model ParkingSpot {
  id          String   @id @default(cuid())
  code        String   @unique
  x           Float
  y           Float
  width       Float
  height      Float
  orientation String
  enabled     Boolean  @default(true)
  role        ParkingSpotRole @default(REGULAR)
  dedicatedVehicleId String?
  dedicatedVehicle Vehicle? @relation("DedicatedVehicle", fields: [dedicatedVehicleId], references: [id], onDelete: NoAction)
  label       String?
  vehicle     Vehicle?
  version     Int      @default(1)
}

model Trip {
  id            String     @id @default(cuid())
  employeeId    String
  employee      Employee   @relation(fields: [employeeId], references: [id])
  vehicleId     String
  vehicle       Vehicle    @relation(fields: [vehicleId], references: [id])
  plannedStart  DateTime
  plannedEnd    DateTime
  actualStart   DateTime?
  actualEnd     DateTime?
  // NULL identifies legacy records whose start-time details were never captured.
  snapshotCapturedAt DateTime?
  employeeNameAtStart String?
  employeeCodeAtStart String?
  departmentNameAtStart String?
  vehicleNameAtStart String?
  vehicleCodeAtStart String?
  plateNumberAtStart String?
  returnSpotCode String?
  returnFuelLevel Int?
  previousFuelLevel Int?
  purpose       String?
  status        TripStatus @default(RESERVED)
  version       Int        @default(1)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([plannedStart, plannedEnd])
  @@index([vehicleId, status])
  @@index([vehicleId, actualStart, id])
  @@index([employeeId, status])
  @@index([status, plannedStart])
}

// 車両の整備記録。予定（SCHEDULED）の期間は予約できない。plannedEndは戻り予定で、未定ならnull。
model VehicleMaintenance {
  id             String            @id @default(cuid())
  vehicleId      String
  vehicle        Vehicle           @relation(fields: [vehicleId], references: [id])
  kind           MaintenanceKind
  status         MaintenanceStatus @default(SCHEDULED)
  note           String?
  plannedStart   DateTime
  plannedEnd     DateTime?
  actualStart    DateTime?
  actualEnd      DateTime?
  returnSpotCode String?
  version        Int               @default(1)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([vehicleId, status])
  @@index([plannedStart, plannedEnd])
}

model AuditLog {
  id          String   @id @default(cuid())
  operationId String?  @unique
  actorEmployeeId String?
  actorEmployee Employee? @relation(fields: [actorEmployeeId], references: [id], onDelete: SetNull)
  actorName   String
  action      String
  targetType  String
  targetId    String
  description String
  createdAt   DateTime @default(now())

  @@index([actorEmployeeId])
  @@index([createdAt])
  @@index([targetType, targetId, createdAt])
}
