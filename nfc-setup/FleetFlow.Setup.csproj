<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>FleetFlow-Setup</AssemblyName>
    <PayloadDirectory Condition="'$(PayloadDirectory)' == ''">../scanner-payload</PayloadDirectory>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(PayloadDirectory)/*" LogicalName="Payload.%(Filename)%(Extension)" WithCulture="false" />
  </ItemGroup>
</Project>
